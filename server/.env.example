# Core & Server Configuration
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/aptech_db
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=aptech:
REDIS_ENABLED=true

# Security & JWT Credentials
JWT_ACCESS_SECRET=your_access_secret_key_min_16_characters
JWT_REFRESH_SECRET=your_refresh_secret_key_min_16_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10
SMS_PROVIDER=mock

# ProConnect Student SSO Integration
PROCONNECT_API_URL=http://localhost:8000/api/v1/mock/proconnect
PROCONNECT_CLIENT_ID=tbx_aptech_client_2026
PROCONNECT_CLIENT_SECRET=tbx_aptech_secret_super_secure_2026
PROCONNECT_PROVIDER=mock

# Aptech Academic Coin Integration
APTECH_COIN_API_URL=http://localhost:5175/api/v1/coins
APTECH_COIN_PROVIDER=http

# Hubble Money Voucher Redemption Integration
HUBBLE_CLIENT_ID=your_hubble_client_id
HUBBLE_APP_SECRET=your_hubble_app_secret
HUBBLE_SDK_BASE_URL=https://sdk.dev.myhubble.money
HUBBLE_WEBHOOK_SECRET=your_hubble_webhook_secret
HUBBLE_MOCK_SSO=false

# TransBnk / TBX Prepaid Card Gateway Integration
TRANSBNK_BASE_URL=https://sandbox-api.trusthub.in
TRANSBNK_API_KEY=your_transbank_api_key
TRANSBNK_CLIENT_ID=your_transbank_client_id
TRANSBNK_USERNAME=your_transbank_username
TRANSBNK_CLIENT_PASSWORD=your_transbank_password
TRANSBNK_PROVIDER=http
