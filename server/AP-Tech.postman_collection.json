      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "hubble_secret",
      "value": "test-hubble-secret",
      "type": "string"
    }
  ],
